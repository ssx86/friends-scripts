---
import Shell from "../../layouts/Shell.astro";
import { allEpisodes, renderScript, epUrl, esc } from "../../lib/build.mjs";

export function getStaticPaths() {
  const eps = allEpisodes(process.cwd());
  return eps.map((ep) => ({
    params: { id: `s${String(ep.s).padStart(2, "0")}e${ep.e}` },
    props: { ep },
  }));
}
const { ep } = Astro.props;
const eps = allEpisodes(process.cwd());
const i = eps.findIndex((x) => x.s === ep.s && String(x.e) === String(ep.e));
const prev = eps[i - 1], next = eps[i + 1];
const dialogues = ep.lines.filter((l) => l.w !== undefined).length;
---
<Shell title={`${ep.t} (S${ep.s}×${ep.e}) · 老友记台词库`} desc={`老友记 S${ep.s}×${ep.e} ${ep.t} 全台词（${dialogues} 句）：可悬停查词、跳句定位。`} season={ep.s}>
  <div class="reader">
    <div class="ep-head">
      <div class="code">
        <svg class="ep-cup" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="cupBody" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#8b7cf6" stop-opacity=".9"/>
              <stop offset="1" stop-color="#6c5ce7" stop-opacity=".7"/>
            </linearGradient>
            <linearGradient id="cupHandle" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#8b7cf6" stop-opacity=".8"/>
              <stop offset="1" stop-color="#6c5ce7" stop-opacity=".5"/>
            </linearGradient>
            <linearGradient id="coffee" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#3d2b1f"/>
              <stop offset="1" stop-color="#2a1a0e"/>
            </linearGradient>
            <radialGradient id="glow" cx=".5" cy=".5" r=".5">
              <stop offset="0" stop-color="#8b7cf6" stop-opacity=".3"/>
              <stop offset="1" stop-color="#8b7cf6" stop-opacity="0"/>
            </radialGradient>
          </defs>
          <!-- 辉光底 -->
          <circle cx="32" cy="36" r="28" fill="url(#glow)"/>
          <!-- 杯身 -->
          <path d="M18 26h24v16a12 12 0 0 1-12 12h0a12 12 0 0 1-12-12V26z" fill="url(#cupBody)" stroke="#8b7cf6" stroke-opacity=".4" stroke-width=".8"/>
          <!-- 杯口椭圆 -->
          <ellipse cx="30" cy="26" rx="12" ry="3.5" fill="#a29bfe" opacity=".6"/>
          <ellipse cx="30" cy="26" rx="10" ry="2.5" fill="url(#coffee)"/>
          <!-- 咖啡高光 -->
          <ellipse cx="27" cy="25.5" rx="3" ry=".8" fill="#5d4037" opacity=".5"/>
          <!-- 杯柄 -->
          <path d="M42 30h5a6 6 0 0 1 0 12h-5" fill="none" stroke="url(#cupHandle)" stroke-width="3" stroke-linecap="round"/>
          <!-- 杯身高光带 -->
          <path d="M22 28v12" stroke="#fff" stroke-opacity=".15" stroke-width="2" stroke-linecap="round"/>
          <path d="M25 27v15" stroke="#fff" stroke-opacity=".08" stroke-width="1.5" stroke-linecap="round"/>
          <!-- 杯底阴影 -->
          <ellipse cx="30" cy="54" rx="11" ry="2" fill="#000" opacity=".2"/>
          <!-- 蒸汽：三条弯曲路径 -->
          <path class="steam s1" d="M25 22c-1-3 1-4 0-7s2-3 1-6" stroke="#a29bfe" stroke-width="1.5" stroke-linecap="round" fill="none" opacity=".5"/>
          <path class="steam s2" d="M30 21c-1-3 1-4 0-7s2-3 1-6" stroke="#a29bfe" stroke-width="1.5" stroke-linecap="round" fill="none" opacity=".4"/>
          <path class="steam s3" d="M35 22c-1-3 1-4 0-7s2-3 1-6" stroke="#a29bfe" stroke-width="1.5" stroke-linecap="round" fill="none" opacity=".3"/>
        </svg>
        EPISODE {ep.s} × {ep.e}
      </div>
      <h2>{ep.t}</h2>
    </div>
    <article class="script" set:html={renderScript(ep)} />
    <div class="pager">
      {prev ? (
        <a class="pg prev" href={epUrl(prev.s, prev.e)}><span>← PREV</span><b>{prev.t}</b></a>
      ) : <span></span>}
      {next ? (
        <a class="pg next" href={epUrl(next.s, next.e)}><span>NEXT →</span><b>{next.t}</b></a>
      ) : null}
    </div>
  </div>
</Shell>
