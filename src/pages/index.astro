---
import Shell from "../layouts/Shell.astro";
import { allEpisodes, epUrl, esc } from "../lib/build.mjs";

const eps = allEpisodes(process.cwd());
const byS = new Map();
for (const ep of eps) if (!byS.has(ep.s)) byS.set(ep.s, ep);
const DOTS = ["#ff6b6b","#4ecdc4","#f9ca24","#a29bfe","#55efc4","#fd79a8","#81ecec","#e17055","#74b9ff","#e84393"];
/* 每季独特插画：SVG 场景（咖啡/雨伞/沙发/门框/吉他/爱心循环） */
const SEASON_ART = [
  // S1: Central Perk 咖啡杯 + 蒸汽
  `<svg viewBox="0 0 80 56" fill="none"><path d="M20 28h28v12a12 12 0 0 1-12 12h-4a12 12 0 0 1-12-12z" fill="#ff9e64" opacity=".85"/><path d="M48 30h6a7 7 0 0 1 0 14h-6" stroke="#ff9e64" stroke-width="3" stroke-linecap="round"/><path d="M28 20c0-3 4-3 4-6M38 20c0-3 4-3 4-6" stroke="#ffcc99" stroke-width="2.5" stroke-linecap="round" opacity=".6"/><ellipse cx="34" cy="28" rx="14" ry="3" fill="#c68642" opacity=".4"/></svg>`,
  // S2: 雨伞
  `<svg viewBox="0 0 80 56" fill="none"><path d="M40 6C28 6 18 14 16 24c3-2 6-2 8 0 2-2 5-2 8 0 2-2 5-2 8 0s6 2 8 0c2-2 5-2 8 0-2-10-12-18-24-18z" fill="#4fd1c5" opacity=".8"/><path d="M40 24v22a7 7 0 0 0 7 7" stroke="#4fd1c5" stroke-width="3.5" stroke-linecap="round"/><path d="M36 44l-6 6M44 44l6 6M34 48l-4 4M46 48l4 4" stroke="#4fd1c5" stroke-width="1.5" stroke-linecap="round" opacity=".4"/></svg>`,
  // S3: 橙色沙发
  `<svg viewBox="0 0 80 56" fill="none"><rect x="12" y="18" width="14" height="22" rx="6" fill="#ff9e64" opacity=".7"/><rect x="54" y="18" width="14" height="22" rx="6" fill="#ff9e64" opacity=".7"/><rect x="16" y="26" width="48" height="18" rx="8" fill="#ff9e64" opacity=".85"/><rect x="10" y="40" width="60" height="8" rx="4" fill="#c68642" opacity=".6"/><path d="M18 48v4M62 48v4" stroke="#c68642" stroke-width="3" stroke-linecap="round"/><circle cx="28" cy="35" r="2" fill="#fff" opacity=".3"/><circle cx="52" cy="35" r="2" fill="#fff" opacity=".3"/></svg>`,
  // S4: 紫色门 + 黄色猫眼框
  `<svg viewBox="0 0 80 56" fill="none"><rect x="16" y="6" width="48" height="48" rx="4" fill="#a29bfe" opacity=".25"/><rect x="22" y="12" width="36" height="40" rx="3" fill="#a29bfe" opacity=".45"/><rect x="30" y="22" width="20" height="14" rx="4" fill="none" stroke="#f9ca24" stroke-width="3"/><circle cx="40" cy="29" r="2.5" fill="#f9ca24"/><circle cx="54" cy="34" r="1.5" fill="#f9ca24" opacity=".7"/></svg>`,
  // S5: 吉他
  `<svg viewBox="0 0 80 56" fill="none"><path d="M46 4l10 10-14 14c4 3 5 7 4 11-2 6-9 9-15 7s-9-9-7-14c2-4 6-5 9-4L50 10z" fill="#a29bfe" opacity=".7"/><circle cx="36" cy="42" r="4" fill="#a29bfe" opacity=".4"/><path d="M40 38l4 4M42 36l4 4" stroke="#f9ca24" stroke-width="1.5" stroke-linecap="round" opacity=".6"/></svg>`,
  // S6: 爱心
  `<svg viewBox="0 0 80 56" fill="none"><path d="M40 48C26 38 20 30 20 22a10 10 0 0 1 18-6A10 10 0 0 1 56 22c0 8-6 16-16 26z" fill="#fd79a8" opacity=".75"/><path d="M28 22a6 6 0 0 1 6-6" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity=".3"/><circle cx="70" cy="12" r="3" fill="#fd79a8" opacity=".3"/><circle cx="12" cy="40" r="2" fill="#fd79a8" opacity=".3"/></svg>`,
  // S7: 婚礼蛋糕
  `<svg viewBox="0 0 80 56" fill="none"><path d="M24 40h32v8H24z" fill="#81ecec" opacity=".5"/><path d="M30 28h20v12H30z" fill="#81ecec" opacity=".6"/><path d="M34 18h12v10H34z" fill="#81ecec" opacity=".7"/><path d="M40 10v4" stroke="#f9ca24" stroke-width="2" stroke-linecap="round"/><circle cx="40" cy="8" r="2" fill="#f9ca24"/><path d="M28 44h24" stroke="#fff" stroke-width="1.5" opacity=".3"/><path d="M34 34h12" stroke="#fff" stroke-width="1" opacity=".3"/></svg>`,
  // S8: 伦敦巴士
  `<svg viewBox="0 0 80 56" fill="none"><rect x="14" y="14" width="52" height="30" rx="6" fill="#e17055" opacity=".75"/><rect x="20" y="20" width="10" height="10" rx="2" fill="#fff" opacity=".35"/><rect x="34" y="20" width="10" height="10" rx="2" fill="#fff" opacity=".35"/><rect x="48" y="20" width="10" height="10" rx="2" fill="#fff" opacity=".35"/><circle cx="26" cy="44" r="5" fill="#2d3436"/><circle cx="54" cy="44" r="5" fill="#2d3436"/><rect x="14" y="14" width="52" height="4" rx="2" fill="#fff" opacity=".15"/></svg>`,
  // S9: 钥匙
  `<svg viewBox="0 0 80 56" fill="none"><circle cx="30" cy="28" r="10" fill="none" stroke="#74b9ff" stroke-width="4"/><path d="M40 28h24M56 28v8M62 28v6" stroke="#74b9ff" stroke-width="4" stroke-linecap="round"/><circle cx="30" cy="28" r="3" fill="#74b9ff" opacity=".4"/><circle cx="68" cy="14" r="2" fill="#74b9ff" opacity=".3"/><circle cx="14" cy="44" r="1.5" fill="#74b9ff" opacity=".3"/></svg>`,
  // S10: 最后的钥匙 + 泡泡
  `<svg viewBox="0 0 80 56" fill="none"><path d="M28 40c8 0 14-6 14-14s-6-14-14-14-14 6-14 14" fill="none" stroke="#e84393" stroke-width="3" stroke-linecap="round" stroke-dasharray="4 3"/><circle cx="30" cy="12" r="2" fill="#e84393" opacity=".6"/><circle cx="52" cy="18" r="3" fill="#e84393" opacity=".3"/><circle cx="58" cy="36" r="2" fill="#e84393" opacity=".4"/><circle cx="46" cy="46" r="1.5" fill="#e84393" opacity=".5"/><path d="M22 26l6 6" stroke="#e84393" stroke-width="3" stroke-linecap="round"/></svg>`,
];
const SEASON_GRADS = [
  "linear-gradient(135deg,rgba(255,158,100,.15),rgba(255,158,100,.03))",
  "linear-gradient(135deg,rgba(79,209,197,.15),rgba(79,209,197,.03))",
  "linear-gradient(135deg,rgba(255,158,100,.12),rgba(139,124,246,.05))",
  "linear-gradient(135deg,rgba(162,155,254,.15),rgba(162,155,254,.03))",
  "linear-gradient(135deg,rgba(162,155,254,.12),rgba(249,202,36,.05))",
  "linear-gradient(135deg,rgba(253,121,168,.15),rgba(253,121,168,.03))",
  "linear-gradient(135deg,rgba(129,236,236,.15),rgba(129,236,236,.03))",
  "linear-gradient(135deg,rgba(225,112,85,.15),rgba(225,112,85,.03))",
  "linear-gradient(135deg,rgba(116,185,255,.15),rgba(116,185,255,.03))",
  "linear-gradient(135deg,rgba(232,67,147,.15),rgba(232,67,147,.03))",
];
const dialogues = eps.reduce((a, e) => a + e.lines.filter((l) => l.w !== undefined).length, 0);
---
<Shell title="老友记台词库 · Friends Scripts">
  <div class="landing">
    <div class="hero-visual">
      <div class="glow-orb a"></div>
      <div class="glow-orb b"></div>
      <div class="peephole"><img class="cover" src={import.meta.env.BASE_URL + "cover.jpg"} alt="Friends" width="280" /></div>
    </div>
    <h1>老友记 · 台词库<small>TEN SEASONS · ALL LINES</small></h1>
    <div class="stats">
      <div class="stat"><b>228</b><span>EPISODES</span></div>
      <div class="stat"><b>{dialogues.toLocaleString("en-US")}</b><span>DIALOGUES</span></div>
      <div class="stat"><b>873,135</b><span>WORDS</span></div>
    </div>
    <p class="hint">悬停任意单词查中英释义与词频（ECDICT）· <kbd>/</kbd> 搜索台词（支持拼错）· <kbd>←</kbd><kbd>→</kbd> 上下集</p>
    <div class="season-grid" id="season-grid">
      {[...byS.entries()].sort((a, b) => a[0] - b[0]).map(([s, ep]) => (
        <a class="sg" href={epUrl(s, ep.e)} style={`--sg-grad:${SEASON_GRADS[s - 1]};--sg-glow:${DOTS[s - 1]}33`}>
          <div class="sg-art" set:html={SEASON_ART[s - 1]} />
          <div class="tt"><b>Season {s}</b><span>{eps.filter((x) => x.s === s).length} EPISODES</span></div>
        </a>
      ))}
    </div>
    <p class="lyric">I'LL BE THERE FOR YOU</p>
    <section class="panel" id="mastery">
      <h2>生词掌握进度</h2>
      <div id="mastery-body"><div class="vsub">载入统计中…（首次需下载句级词表索引）</div></div>
    </section>
  </div>
</Shell>
